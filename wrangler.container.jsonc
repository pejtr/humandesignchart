{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "humandesignchart-cloudflare",
  "main": "workers/cloudflare-container.js",
  "compatibility_date": "2026-10-03",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "HumanDesignContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile.cloudflare"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_CONTAINER",
        "class_name": "HumanDesignContainer"
      }
    ]
  },
  "exports": {
    "HumanDesignContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
